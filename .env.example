# Server & Proxy
PORT=3000
NODE_ENV=development
APP_URL=
CORS_ORIGIN=
TRUST_PROXY=

# WebRTC STUN / TURN
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600

# Room Capacity (10 devices max total per room: 1 source + up to 9 receivers) & Lifetime
MAX_ACTIVE_ROOMS=200
MAX_RECEIVERS_PER_ROOM=9
ROOM_IDLE_TTL_MS=1800000
ROOM_MAX_LIFETIME=24h
ROOM_MAX_LIFETIME_MS=86400000
ROOM_AUTH_SECRET=

# Firebase Authentication (server ID token verification & admin room lifetime overrides)
FIREBASE_PROJECT_ID=
ADMIN_EMAILS=